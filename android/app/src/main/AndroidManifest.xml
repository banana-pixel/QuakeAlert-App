<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Add-a-Sensor wizard: WifiNetworkSpecifier (NodeLink.bindToNode) needs
      CHANGE_NETWORK_STATE to bring up the bound secondary network that talks to
      the node's SoftAP. Normal permission — granted at install, never prompted.
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!--
      Life-safety alert delivery (.clinerules/20 rule 3). USE_FULL_SCREEN_INTENT is
      what lets an earthquake notification raise WarningActivity over the lock screen
      without the user touching anything; from API 34 the grant is automatic only for
      calling and alarm apps, so WarningNotifier checks canUseFullScreenIntent() and
      falls back to a heads-up notification. VIBRATE and WAKE_LOCK back the alert's
      haptics and keep the device awake for the siren.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      The Warning screen's SOS LIGHT control strobes the camera flash via
      CameraManager.setTorchMode, which needs no permission (API 23+) — and the
      CAMERA permission is deliberately NOT declared, since the app never opens a
      capture session and asking for it would be asking for far more access than
      the feature uses. Declared not required so a flashless device can still
      install; TorchController checks FLASH_INFO_AVAILABLE at runtime and the
      control reports back when the light could not be turned on.
    -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuakeAlert">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuakeAlert"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The full-screen earthquake alert. Not exported: it is raised only by this
          app's own notification, never by another app. singleTop so a second alert
          reuses the instance already on screen (and keeps the user's mute) rather
          than stacking a second red screen behind the first. showWhenLocked and
          turnScreenOn are set in code as well — the manifest attributes cover the
          cold-start case before onCreate runs.
        -->
        <activity
            android:name=".ui.warning.WarningActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.QuakeAlert"
            android:turnScreenOn="true" />

        <!--
          Data-only FCM handler. Present unconditionally; without an
          app/google-services.json no FirebaseApp is initialised, so it is never
          instantiated and alerts arrive over the WebSocket only
          (docs/FIREBASE_SETUP.md).
        -->
        <service
            android:name=".service.QuakeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Fallback channel for any notification that arrives without one. Real alerts
          are posted on WarningNotifier.CHANNEL_ID, which is created at app start with
          IMPORTANCE_HIGH so its full-screen intent is honoured.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
    </application>

</manifest>