<!--
  Small icon for the ongoing status notification (StatusNotifier). A seismic trace
  rather than the warning triangle of ic_alert_triangle.xml: this notification says
  "listening", and the triangle is reserved for an alert that is actually happening.

  Drawn at 24dp, the size Android renders a notification small icon at, with the
  glyph filling the viewport — the 74dp ic_recording_wave.xml keeps its trace in the
  middle third of a 165 viewport, which scales down to a few grey pixels in the bar.
  Solid white on transparent, as the platform tints and masks the small icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M2,12H4.5L7,6L10.5,18L14,3L17.5,18L19.5,12H22"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
