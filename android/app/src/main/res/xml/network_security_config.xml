<?xml version="1.0" encoding="utf-8"?>
<!--
  Transport policy for the app.

  ADR-0003 and .clinerules/20 rule 6 require HTTPS/WSS with no cleartext, so the
  base config keeps cleartext OFF app-wide: production traffic to
  api.quakealert.id can never silently downgrade to http://.

  The single exception is the development loopback used by the Android emulator
  (10.0.2.2 = the host machine running server/docker-compose.yml, plus localhost
  for an on-device port forward). Scoping the exception to those two hosts is
  strictly narrower than android:usesCleartextTraffic="true", which would permit
  cleartext to every host including production.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulator alias for the host loopback interface. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Direct loopback, e.g. `adb reverse tcp:8080 tcp:8080` on a device. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
