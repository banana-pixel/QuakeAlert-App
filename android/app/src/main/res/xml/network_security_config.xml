<?xml version="1.0" encoding="utf-8"?>
<!--
  Transport policy for the app.

  ADR-0003 and .clinerules/20 rule 6 require HTTPS/WSS with no cleartext, so the
  base config keeps cleartext OFF app-wide: production traffic to
  api.quakealert.id can never silently downgrade to http://.

  The exceptions are development loopback and the sensor node's own provisioning
  portal, which is inherently plaintext: the ESP32 SoftAP serves a plain WebServer
  (firmware/src/network.cpp) with no TLS capability, and it is only ever reachable
  while the phone holds a specifier-bound connection to that AP (device/NodeLink.kt)
  - there is no route to 192.168.4.1 through any other network. Scoping the
  exception to these hosts is strictly narrower than
  android:usesCleartextTraffic="true", which would permit cleartext to every host
  including production.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulator alias for the host loopback interface. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Direct loopback, e.g. `adb reverse tcp:8080 tcp:8080` on a device. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Sensor node's SoftAP gateway during Add-a-Sensor provisioning. -->
        <domain includeSubdomains="false">192.168.4.1</domain>
    </domain-config>
</network-security-config>
