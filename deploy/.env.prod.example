# =============================================================================
# QuakeAlert — template environment PRODUKSI
#
#   cp .env.prod.example .env.prod   &&   chmod 600 .env.prod
#
# .env.prod berisi secret dan TIDAK boleh masuk git (sudah di .gitignore).
# Setiap baris di bawah wajib diisi kecuali yang ditandai opsional; compose akan
# menolak start bila salah satu yang wajib kosong — lebih baik gagal saat deploy
# daripada berjalan dengan kunci default.
# =============================================================================

# --- Domain (A record keduanya harus sudah mengarah ke VPS ini) --------------
# Caddy memverifikasi kepemilikan lewat HTTP-01; DNS yang belum propagasi berarti
# tidak ada sertifikat, dan tanpa sertifikat broker tidak menerima node.
API_DOMAIN=api.quakealert.id
MQTT_DOMAIN=broker.quakealert.id
ACME_EMAIL=ops@quakealert.id

# --- Postgres ---------------------------------------------------------------
# openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Kunci aplikasi ---------------------------------------------------------
# MASTER_KEY_HEX: 64 hex char (AES-256) untuk membuka secret_key_enc node.
#   openssl rand -hex 32
# MENGGANTINYA MEMBUAT SELURUH NODE YANG SUDAH TERPASANG TIDAK BISA DIVERIFIKASI.
MASTER_KEY_HEX=

# JWT_SECRET: minimal 32 byte. Menggantinya membuat setiap token anonim yang
# beredar tidak sah — pengguna kehilangan identitas dan pseudonimnya.
#   openssl rand -base64 48
JWT_SECRET=
JWT_TTL_HOURS=720

# --- MQTT -------------------------------------------------------------------
# Password untuk user yang dibuat scripts/init-mqtt-users.sh. Yang node dipakai
# firmware (firmware/src/secrets.h) dan dibagi seluruh node, jadi ia harus
# diperlakukan sebagai kredensial yang bisa dibongkar dari perangkat.
MQTT_SERVER_USER=quakealert-server
MQTT_SERVER_PASSWORD=
MQTT_NODE_USER=quakealert-node
MQTT_NODE_PASSWORD=
MQTT_MONITOR_USER=quakealert-monitor
MQTT_MONITOR_PASSWORD=

# --- FCM (opsional; kosong = hanya WebSocket, tanpa notifikasi background) ---
# File JSON service account ditaruh di deploy/secrets/ dan dibaca read-only.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=/secrets/fcm-service-account.json

# --- WebSocket --------------------------------------------------------------
# Comma-separated. Aplikasi Android tidak mengirim Origin sehingga tidak
# terpengaruh; isi hanya bila ada dasbor web. Kosong = tolak semua lintas-origin.
WS_ALLOWED_ORIGINS=

# --- Tuning (biarkan default kecuali ada alasan) ----------------------------
CONSENSUS_WINDOW_MS=8000
COOLDOWN_MS=90000
IO_TIMEOUT_MS=2000
VERSION=prod
