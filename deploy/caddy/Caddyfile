# =============================================================================
# QuakeAlert — reverse proxy produksi (Caddy 2)
#
# Caddy dipilih ketimbang Nginx karena satu alasan operasional: sertifikat ACME
# diterbitkan dan diperpanjang sendiri tanpa cron, certbot, atau reload manual.
# Pada VPS 1 vCPU yang mengangkut jalur life-safety, sertifikat kedaluwarsa yang
# tidak diperhatikan adalah mode kegagalan yang paling mungkin terjadi.
#
# Semua nilai {$VAR} dibaca dari environment container (lihat .env.prod).
# =============================================================================
{
	# Email ACME: dipakai Let's Encrypt untuk peringatan kedaluwarsa.
	email {$ACME_EMAIL}

	# Server internal saja yang mendengarkan HTTP; :80 di sini hanya untuk
	# tantangan ACME dan redirect (otomatis).
	admin off
}

{$API_DOMAIN} {
	encode zstd gzip

	# HSTS. Kliennya adalah aplikasi Android yang selalu memakai HTTPS, jadi
	# tidak ada trafik plaintext sah yang bisa dirugikan header ini.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# /ws adalah WebSocket alert (koneksi panjang, foreground app). Diberi blok
	# sendiri karena timeout default proxy akan memutus koneksi idle — dan
	# koneksi WS yang mati diam-diam berarti perangkat tidak menerima peringatan
	# meski aplikasinya terbuka.
	@ws path /ws
	reverse_proxy @ws server:8080 {
		flush_interval -1
	}

	reverse_proxy server:8080 {
		health_uri /healthz
		health_interval 15s
		health_timeout 3s

		# Batas ini yang membuat Aturan Server #3 (IO <= 2s) terlihat dari luar:
		# permintaan yang menggantung lebih lama adalah bug, bukan trafik lambat.
		transport http {
			dial_timeout 3s
			response_header_timeout 10s
		}
	}

	log {
		output file /var/log/caddy/api.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# Blok ini tidak melayani apa pun: ia ada agar Caddy menerbitkan dan
# memperpanjang sertifikat untuk hostname broker, yang lalu dipakai Mosquitto di
# port 8883 (lihat scripts/sync-mqtt-certs.sh). Mosquitto tidak bisa berbicara
# ACME sendiri, dan menaruh dua penerbit sertifikat di satu host adalah cara
# tercepat mengenai rate limit Let's Encrypt.
{$MQTT_DOMAIN} {
	respond "quakealert mqtt broker — gunakan mqtts://{$MQTT_DOMAIN}:8883" 421
}
