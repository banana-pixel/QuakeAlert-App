#ifndef SECRETS_H
#define SECRETS_H

// ========================================
// SECURITY CREDENTIALS
// Copy this file to secrets.h and fill in your real values.
// Do NOT commit secrets.h (it is in .gitignore).
// ========================================

// MQTT Server Details
#define SECRET_MQTT_SERVER "your-broker.example.com"
#define SECRET_MQTT_PORT 8883

// MQTT Authentication.
//
// The username must be the NODE role, not the server one: the production ACL
// (deploy/mosquitto/aclfile) lets `quakealert-node` publish to
// sensor/<station_id>/{trigger,heartbeat,status} and read only its own command
// topic. A node that connected as `quakealert-server` could subscribe to every
// station in the network and inject commands into other nodes — and this
// credential is readable from any node someone takes apart.
//
// The password is MQTT_NODE_PASSWORD from deploy/.env.prod, hashed into the
// broker's passwd file by deploy/scripts/init-mqtt-users.sh. Because every node
// shares it, rotating it means reflashing the fleet: keep it out of any build
// that leaves your hands.
#define SECRET_MQTT_USER "quakealert-node"
#define SECRET_MQTT_PASS "your_mqtt_node_password"

// Optional: WiFi Backup (If WiFiManager fails)
#define SECRET_WIFI_SSID "YOUR_WIFI_NAME"
#define SECRET_WIFI_PASS "YOUR_WIFI_PASSWORD"

#endif
