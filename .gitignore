# ==========================================================================
# QuakeAlert monorepo .gitignore
# Komponen tinggal di subfolder: android/, server/, firmware/, contracts/, deploy/
# ==========================================================================

# --- OS / editor ---
.DS_Store
*.iml
.idea/
.vscode/

# --- Secrets / env (JANGAN commit) ---
.env
*.env
!*.env.example
# Pola *.env di atas tidak menangkap .env.local (akhirannya .local), padahal
# file itu menyimpan MASTER_KEY_HEX dan JWT_SECRET pengembangan.
.env.local
*.env.local
*secrets.local
android/local.properties
firmware/src/secrets.h
# Backup/rotasi secrets firmware — pola .bak dan variant pre-rotation.
firmware/src/secrets.h.*.bak
firmware/src/*.bak
# Kunci penandatanganan rilis: dipasok lewat env var (QUAKE_KEYSTORE_PATH dkk),
# tidak pernah masuk repo. Lihat android/app/build.gradle.kts signingConfigs.
*.jks
*.keystore
android/keystore.properties

# --- Android (Gradle) ---
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/captures/
android/.externalNativeBuild/
android/.cxx/
android/local.properties
android/**/google-services.json

# --- Firmware (PlatformIO) ---
firmware/.pio/
firmware/.vscode/

# --- Server (Go) ---
server/bin/
server/quakealert
server/.gocache/
server/.gomodcache/
*.test
*.out


# --- Deploy / data volumes lokal ---
deploy/**/data/
server/pgdata/

# --- Deploy produksi (secret & material TLS) ---
# .env.prod tidak tertangkap pola *.env di atas (akhirannya .prod), padahal ia
# memuat POSTGRES_PASSWORD, MASTER_KEY_HEX, JWT_SECRET dan seluruh password MQTT.
.env.prod
deploy/.env.prod
!deploy/.env.prod.example
deploy/.env.staging
# Hash password MQTT: bukan plaintext, tetapi cukup untuk serangan offline.
deploy/mosquitto/passwd
# Sertifikat + kunci privat broker, disalin dari volume Caddy oleh
# scripts/sync-mqtt-certs.sh. Selalu dapat dibuat ulang, jadi tidak ada alasan
# menaruhnya di git.
deploy/mosquitto/certs/
# Sertifikat staging Mosquitto — dibuat ulang oleh scripts, tidak masuk repo.
deploy/mosquitto/staging-certs/
# Service account FCM. Direktorinya sendiri tetap dilacak (lewat .gitkeep) agar
# mount read-only di compose tidak dibuatkan Docker sebagai direktori milik root.
deploy/secrets/*
!deploy/secrets/.gitkeep

# Staging deploy overrides — konfigurasi lokal, bukan production
deploy/caddy/Caddyfile.staging
deploy/docker-compose.staging.override.yml

# Scratch/session files
session.txt
*-hello.txt

# Firebase config files (root-level staging copies; the app/ one is already ignored)
google-services*.json
