# ==========================================================================
# QuakeAlert monorepo .gitignore
# Komponen tinggal di subfolder: android/, server/, firmware/, contracts/, deploy/
# ==========================================================================

# --- OS / editor ---
.DS_Store
*.iml
.idea/
.vscode/

# --- Secrets / env (JANGAN commit) ---
.env
*.env
!*.env.example
# Pola *.env di atas tidak menangkap .env.local (akhirannya .local), padahal
# file itu menyimpan MASTER_KEY_HEX dan JWT_SECRET pengembangan.
.env.local
*.env.local
*secrets.local
android/local.properties
firmware/src/secrets.h

# --- Android (Gradle) ---
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/captures/
android/.externalNativeBuild/
android/.cxx/
android/local.properties
android/**/google-services.json

# --- Firmware (PlatformIO) ---
firmware/.pio/
firmware/.vscode/

# --- Server (Go) ---
server/bin/
server/quakealert
server/.gocache/
server/.gomodcache/
*.test
*.out


# --- Deploy / data volumes lokal ---
deploy/**/data/
server/pgdata/
